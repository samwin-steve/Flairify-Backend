APP_MODE=demo
STORE_BACKEND=sqlite
DATA_DIR=.data
GOOGLE_CLOUD_PROJECT=data-workshops
GOOGLE_CLOUD_LOCATION=us-central1
FIRESTORE_DATABASE=flairify
MEDIA_BUCKET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Keep disabled for public anonymous demo sessions.
ENABLE_PAID_AI=false
# Disabled for credential-free local runs. Production uses a dedicated regional template.
ENABLE_MODEL_ARMOR=false
MODEL_ARMOR_TEMPLATE=
# Set only IDs verified for your project and region. No guessed defaults.
GEMINI_MODEL=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_LOCATION=global
EMBEDDING_DIMENSIONS=768
MAX_DAILY_EMBEDDINGS=1500
# Uses GEMINI_MODEL on Vertex AI, before the existing embedding/index job.
ENABLE_CATALOGUE_ENRICHMENT=true
MAX_DAILY_CATALOGUE_ENRICHMENTS=600
TRY_ON_MODEL=
IMAGE_EDIT_MODEL=
VEO_MODEL=
GOOGLE_PHOTOS_CLIENT_ID=
WORKER_URL=
TASK_SERVICE_ACCOUNT=
TASKS_QUEUE=flairify-jobs
ENABLE_BIGQUERY=false
MAX_DAILY_GRAPH_QUERIES=300
BIGQUERY_DATASET=flairify
MAX_UPLOAD_MB=10
MAX_PHOTOS_PER_USER=30
MAX_DAILY_GENERATIONS=5
ENABLE_DEMO_ADMIN=true
# Set your own local secret. Do not commit it; use Secret Manager on Cloud Run.
DEMO_ADMIN_KEY=

# Optional signed-in live analysis alongside isolated anonymous demos.
ALLOW_FIREBASE_IN_DEMO=false
SEED_SAMPLE_CATALOG=false
# Gemini can use global while Cloud Tasks and image/video models stay regional.
GEMINI_LOCATION=

# Google-only 2D previews. Explicitly allow licensed sample catalogue photographs.
IMAGE_EDIT_LOCATION=global
ALLOW_SAMPLE_TRY_ON=false
MAX_DAILY_IMAGE_GENERATIONS=30

# Automatically queue a separate Gemini shop-style image for each extracted garment.
# Uses IMAGE_EDIT_MODEL; anonymous demos never generate images.
ENABLE_GARMENT_IMAGES=true
MAX_DAILY_GARMENT_IMAGES=12

# Optional Google native audio; verified 13 October 2026 in us-central1: gemini-3.8-live.
# Disabled until a model and paid AI are configured. CORS_ORIGINS must include the web app origin.
LIVE_MODEL=
LIVE_LOCATION=us-central1
LIVE_VOICE=Aoede
# Public backend HTTPS origin; browser audio uses its authenticated WebSocket directly.
LIVE_API_URL=
MAX_LIVE_SECONDS=300
